# ==========================================
# OTPMAN 2 (KSI IPRN) Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. KSI IPRN API Key (from SMS API page)
KSI_API_KEY=your_ksi_api_key_here

# 3. KSI Base URL
KSI_BASE_URL=https://ksiiprn.com

# 4. Primary Telegram Group Chat ID
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# 5. Secondary Telegram Group Chat ID (Optional)
SECONDARY_GROUP_CHAT_ID=

# 6. Message Filter (a2p = OTP SMS only)
MESSAGE_TYPE=a2p

# 7. Polling interval in seconds (12.0s is optimal)
POLL_INTERVAL_SECONDS=12.0

# 8. Allowed Telegram Admin User IDs
ADMIN_USER_IDS=your_telegram_user_id_here

# 9. GitHub Gist Token for 28h cloud persistence
GIST_TOKEN=your_gist_token_here

# 10. Gist ID (Optional — bot auto-creates or auto-discovers Gist)
GIST_ID=
